<!--
  Eurocontainer StorageSystem — 40 SPL slots per arm, mirrored left/right.
-->
<launch>

  <include file="$(find storage_system)/launch/slot_storage_system.launch">
    <arg name="storage_id" value="eurocontainer_left" />
    <arg name="capacity"   value="40" />
  </include>

  <include file="$(find storage_system)/launch/slot_storage_system.launch">
    <arg name="storage_id" value="eurocontainer_right" />
    <arg name="capacity"   value="40" />
  </include>

</launch>
