<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spl_electricalstation">

  <!-- Ensure utilities (PI, helpers) and materials from yumi_description are available -->
  <xacro:include filename="$(find yumi_description)/urdf/Util/utilities.xacro" />
  <xacro:include filename="$(find yumi_description)/urdf/Util/materials.xacro" />
  <!-- Define PI in case utilities.xacro is not available in some include orders -->
  <xacro:property name="PI" value="3.141592653589793"/>

  <!-- Table dimensions -->
  <xacro:property name="table_length" value="1.2"/>
  <xacro:property name="table_width" value="0.8"/>
  <xacro:property name="table_height" value="0.7"/>

  <!-- Table / base_link as a simple box. The link origin (0,0,0) is the CENTER of the box,
       so the top surface of the table sits at z = table_height/2. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${table_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${table_length} ${table_width} ${table_height}" />
      </geometry>
      <material name="Brown">
        <color rgba="0.6 0.4 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${table_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${table_length} ${table_width} ${table_height}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${table_height / 2}" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
  </link>

  <!-- table_top frame: located at the TOP SURFACE of the table (not its geometric center) -->
  <link name="table_top">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="Black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Place table_top at the top surface of the table box -->
  <joint name="base_to_table_top" type="fixed">
    <parent link="base_link"/>
    <child link="table_top"/>
    <origin xyz="0 0 ${table_height}" rpy="0 0 0"/>
  </joint>

  <!-- Include the yumi_description xacro and attach it to table_top -->
  <xacro:include filename="$(find yumi_description)/urdf/yumi.xacro" />

  <!-- Call the yumi macro. The yumi macro signature is: parent name hardware_interface *origin -->
  <!-- yumi_base_link is spawned at table_top's frame (already at the table surface), so no extra offset needed. -->
  <xacro:yumi parent="table_top" name="yumi" hardware_interface="">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:yumi>

  <!-- Attach the yumi base directly on the table surface (table_top), single root remains base_link -->
  <joint name="table_top_to_yumi_base_link" type="fixed">
    <parent link="table_top"/>
    <child link="yumi_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Include and instantiate the Eurocontainer + Redboard slot layout on the table_top -->
  <xacro:include filename="$(find spl_electricalstation_description)/urdf/spl_electricalstation_slots.xacro" />
  <xacro:electrical_station_slots parent="table_top" />

</robot>
