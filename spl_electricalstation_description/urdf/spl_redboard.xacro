<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       spl_redboard.xacro

       Defines a Redboard marker built from the real mesh in the
       "spl_markers" package (meshes/UNP_SPL_Redboard.obj), mounted
       directly on the redboard slot's parent link.

       The mesh's own origin sits roughly at the bottom-center of the
       board (vertex bounding box: x [-0.0555, 0.0555], y [-0.0605, 0.0605],
       z [-0.0008, 0.0351], i.e. already in meters, no rescale needed).

       Usage:
         xacro:spl_redboard parent="redboard_slot_0_0" name="00"

       This creates:
         - link  "redboard_${name}_base_link"  (the visual/collision mesh,
           fixed to "parent" at the parent's origin, this is where the
           mesh actually sits)
         - link  "redboard_${name}_spl_slot"    (reference/mounting frame,
           offset from the base link: "a bit off-centered and 4 cm up")
         - joint "${parent}_to_redboard_${name}_base_link" (fixed)
         - joint "redboard_${name}_base_link_to_spl_slot"  (fixed, applies
           the "a bit off-centered and 4 cm up" offset)
  =================================================================== -->

  <!-- Small horizontal off-center offset + 4 cm vertical lift from the
       base link, applied between the base (mesh) link and the slot frame. -->
  <xacro:property name="redboard_mesh_offset_x" value="0.01"/>
  <xacro:property name="redboard_mesh_offset_y" value="-0.01"/>
  <xacro:property name="redboard_mesh_offset_z" value="0.04"/>

  <xacro:macro name="spl_redboard" params="parent name">

    <!-- Visual/collision mesh link, this is the redboard's base -->
    <link name="redboard_${name}_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://spl_markers/meshes/UNP_SPL_Redboard.obj" scale="1 1 1"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://spl_markers/meshes/UNP_SPL_Redboard.obj" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${parent}_to_redboard_${name}_base_link" type="fixed">
      <parent link="${parent}"/>
      <child link="redboard_${name}_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Reference/mounting frame for this redboard, offset from its base -->
    <link name="redboard_${name}_spl_slot"/>

    <joint name="redboard_${name}_base_link_to_spl_slot" type="fixed">
      <parent link="redboard_${name}_base_link"/>
      <child link="redboard_${name}_spl_slot"/>
      <origin xyz="${redboard_mesh_offset_x} ${redboard_mesh_offset_y} ${redboard_mesh_offset_z}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
